    "test:contradictions": "node scripts/build-server.js && tsx scripts/test-contradiction-radar.ts",
    "test:evidence-graph": "node scripts/build-server.js && tsx scripts/test-evidence-graph.ts",
    "test:decision-simulator": "node scripts/build-server.js && tsx scripts/test-decision-simulator.ts",
    "test:api": "node scripts/test-vercel-endpoints.js",
