# =============================================================================
# Clario - Environment Variables Reference
# Copy to .env and fill in real values. Never commit .env.
# =============================================================================

# ── Gemini AI ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.0-flash"

# ── VerbX One Document Intelligence API ───────────────────────────────────────
# Enables Indian-language OCR, TTS, STT, and Translation.
# Without this key, Clario falls back to: native PDF parse, browser Web Speech
# API (TTS), and built-in translation templates.
VERBX_API_KEY="your_verbx_api_key_here"
VERBX_OCR_ENDPOINT="https://api.verbxeco.com/v1/ocr"
VERBX_TRANSLATION_ENDPOINT="https://api.verbxeco.com/v1/translate"
VERBX_CHAT_ENDPOINT="https://api.verbxeco.com/v1/chat"
VERBX_STT_ENDPOINT="https://api.verbxeco.com/v1/stt"
VERBX_TTS_ENDPOINT="https://api.verbxeco.com/v1/tts"

# ── Supabase ───────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ── App ────────────────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
PORT=3000
